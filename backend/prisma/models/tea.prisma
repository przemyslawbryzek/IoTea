model tea_category {
    id  Int @id @default(autoincrement())
    name String
    icon_url String?
    teas Tea[]
    user_teas user_tea[]
}
model Tea {
    id  Int @id @default(autoincrement())
    name String 
    description String?
    image_url String?
    categoryId Int
    category tea_category @relation(fields: [categoryId], references: [id])
    brew_temp Int
    instructions brewing_instructions[] @relation("TeaInstructions")
    ratings tea_rating[]
    favorites tea_favorite[]
}

model user_tea {
    id Int @id @default(autoincrement())
    owner_id Int
    owner user @relation(fields: [owner_id], references: [id], onDelete: Cascade)
    name String
    description String?
    image_url String?
    categoryId Int
    category tea_category @relation(fields: [categoryId], references: [id])
    brew_temp Int
    instructions brewing_instructions[] @relation("UserTeaInstructions")
    ratings user_tea_rating[]
    favorites user_tea_favorite[]
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([owner_id])
    @@index([categoryId])
}

model tea_rating {
    id Int @id @default(autoincrement())
    userId Int
    teaId Int
    value Int
    user user @relation(fields: [userId], references: [id], onDelete: Cascade)
    tea Tea @relation(fields: [teaId], references: [id], onDelete: Cascade)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([userId, teaId])
    @@index([teaId])
    @@index([userId])
}

model tea_favorite {
    id Int @id @default(autoincrement())
    userId Int
    teaId Int
    user user @relation(fields: [userId], references: [id], onDelete: Cascade)
    tea Tea @relation(fields: [teaId], references: [id], onDelete: Cascade)
    created_at DateTime @default(now())

    @@unique([userId, teaId])
    @@index([teaId])
    @@index([userId])
}

model user_tea_rating {
    id Int @id @default(autoincrement())
    userId Int
    userTeaId Int
    value Int
    user user @relation(fields: [userId], references: [id], onDelete: Cascade)
    userTea user_tea @relation(fields: [userTeaId], references: [id], onDelete: Cascade)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@unique([userId, userTeaId])
    @@index([userTeaId])
    @@index([userId])
}

model user_tea_favorite {
    id Int @id @default(autoincrement())
    userId Int
    userTeaId Int
    user user @relation(fields: [userId], references: [id], onDelete: Cascade)
    userTea user_tea @relation(fields: [userTeaId], references: [id], onDelete: Cascade)
    created_at DateTime @default(now())

    @@unique([userId, userTeaId])
    @@index([userTeaId])
    @@index([userId])
}

model brewing_style{
    id  Int @id @default(autoincrement())
    name String
    description String?
    instructions brewing_instructions[]
}
model brewing_instructions{
    id  Int @id @default(autoincrement())
    teaId Int?
    userTeaId Int?
    styleId Int
    tea Tea? @relation("TeaInstructions", fields: [teaId], references: [id], onDelete: Cascade)
    userTea user_tea? @relation("UserTeaInstructions", fields: [userTeaId], references: [id], onDelete: Cascade)
    style brewing_style @relation(fields: [styleId], references: [id])
    grams_per_100ml Decimal
    first_infusion_seconds Int
    increment_seconds Int
    max_infusions Int
    brew brew[]

    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([teaId])
    @@index([userTeaId])
    @@index([styleId])
}