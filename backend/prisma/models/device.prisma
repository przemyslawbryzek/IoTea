model device {
    id  Int @id @default(autoincrement())
    name String
    owner_id Int
    owner user @relation(fields: [owner_id], references: [id])
    model String?
    firmware_version String?
    public_key String?
    mqtt_username String @unique
    mqtt_password String
    last_seen DateTime?
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    brews brew[]
    device_status_events device_status_event[]
    brew_status_events brew_status_event[]
    @@index([owner_id])
    @@index([last_seen])
}