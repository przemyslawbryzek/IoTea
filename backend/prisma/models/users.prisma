model user {
  id           Int              @id @default(autoincrement())
  email        String           @unique
  password     String
  name         String?
  role         role             @default(USER)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
  devices      device[]
  user_teas    user_tea[]
  tea_ratings tea_rating[]
  tea_favorites tea_favorite[]
  user_tea_ratings user_tea_rating[]
  user_tea_favorites user_tea_favorite[]
  push_tokens push_token[]
}

enum role {
  USER
  ADMIN
}
