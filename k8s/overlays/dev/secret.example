  MQTT_API_SECRET: rr9A9B0VhCf2hk8qjt9AmTffgRwZS10pVFfYmVvO38HpUM
  MQTT_WORKER_USERNAME: mqtt_worker
  MQTT_WORKER_PASSWORD: mqtt_worker_pass
  MQTT_API_USERNAME: mqtt_api_user
  MQTT_API_PASSWORD: mqtt_api_pass
  FIREBASE_PROJECT_ID: firebase_project_id_placeholder
  FIREBASE_CLIENT_EMAIL: firebase_client_email_placeholder
  FIREBASE_PRIVATE_KEY: private_key_placeholder